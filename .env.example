# --- Secrets ---
OPENAI_API_KEY=your-openai-api-key-here
SESSION_SECRET=your-64-hex-secret-here
ADMIN_API_KEY=your-64-hex-admin-key-here

# --- DB ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- ChromaDB ---
CHROMA_DB_PATH=/var/lib/docrag/chroma_db

# --- RAG: chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RESPONSE_TOKENS=700
TEMPERATURE=0.25

# --- Crawler  ---
DOC_USE_SAMPLE=false
DOC_MAX_PAGES_PER_SOURCE=300
DOC_CRAWL_DELAY=0.7
DOC_CRAWL_TIMEOUT=15

# --- timeouts/retries ---
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2
REQUESTS_MAX_RETRIES=2
REQUESTS_BACKOFF_FACTOR=0.5

# --- Limits  ---
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL=3600

# ---  ---
ENV=production

# --- Web Server (Gunicorn - OLD, Uvicorn - NEW) ---
WEB_CONCURRENCY=2              # Number of worker processes (uvicorn/gunicorn)
WEB_THREADS=1                  # Threads per worker (gunicorn only)
LOG_LEVEL=info
FORWARDED_ALLOW_IPS=*

# --- FastAPI/Uvicorn (NEW) ---
FASTAPI_ENABLED=true           # Enable FastAPI application
UVICORN_HOST=0.0.0.0          # Server host (0.0.0.0 for all interfaces)
UVICORN_LOG_LEVEL=info        # Uvicorn log level
PORT=8000                      # Server port
ASYNC_DB_POOL_SIZE=20         # Async database connection pool size
ASYNC_DB_MAX_OVERFLOW=10      # Max overflow connections for async pool