# --- Secrets ---
# AI Provider Configuration (Hybrid Approach - Recommended)
# Use OpenRouter for FREE chat + OpenAI for reliable embeddings

# OpenRouter (FREE chat models)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b:free  # Free models: gpt-oss-120b:free, nemotron-nano-12b-v2-vl:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small  # Only used if USE_OPENAI_EMBEDDINGS=false
USE_OPENROUTER=true  # Set to false to use OpenAI for everything (paid)

# OpenAI (For embeddings - REQUIRED for RAG to work properly)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo  # Options: gpt-3.5-turbo (cheap), gpt-4o (best quality)
USE_OPENAI_EMBEDDINGS=true  # Recommended: true (embeddings are cheap ~$0.02/M tokens)

# Cost Breakdown with Hybrid Approach:
# - Chat (OpenRouter): $0.00 (FREE)
# - Embeddings (OpenAI): ~$0.10 per 1000 queries (very cheap)
# Total: ~$0.10 vs $25+ with OpenAI-only

# Security
SESSION_SECRET=your-64-hex-secret-here
ADMIN_API_KEY=your-64-hex-admin-key-here

# --- DB ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_SSLMODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- ChromaDB ---
CHROMA_DB_PATH=/var/lib/docrag/chroma_db

# --- RAG: chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_RESPONSE_TOKENS=700
TEMPERATURE=0.25

# --- Crawler  ---
DOC_USE_SAMPLE=false
DOC_MAX_PAGES_PER_SOURCE=300
DOC_CRAWL_DELAY=0.7
DOC_CRAWL_TIMEOUT=15

# --- timeouts/retries ---
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2
REQUESTS_MAX_RETRIES=2
REQUESTS_BACKOFF_FACTOR=0.5

# --- Limits  ---
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL=3600

# ---  ---
ENV=production

# --- Web Server (Gunicorn - OLD, Uvicorn - NEW) ---
WEB_CONCURRENCY=2              # Number of worker processes (uvicorn/gunicorn)
WEB_THREADS=1                  # Threads per worker (gunicorn only)
LOG_LEVEL=info
FORWARDED_ALLOW_IPS=*

# --- FastAPI/Uvicorn (NEW) ---
FASTAPI_ENABLED=true           # Enable FastAPI application
UVICORN_HOST=0.0.0.0          # Server host (0.0.0.0 for all interfaces)
UVICORN_LOG_LEVEL=info        # Uvicorn log level
PORT=8000                      # Server port
ASYNC_DB_POOL_SIZE=20         # Async database connection pool size
ASYNC_DB_MAX_OVERFLOW=10      # Max overflow connections for async pool