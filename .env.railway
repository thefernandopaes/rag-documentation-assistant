# ===============================================
# Railway Production Environment Variables
# ===============================================
# Copie estas variáveis para o Railway Dashboard
# ===============================================

# --- AI Provider (ESSENCIAL) ---
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openai/gpt-oss-120b:free
USE_OPENROUTER=true

# --- Security (GERE NOVOS VALORES!) ---
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
ADMIN_API_KEY=x1y2z3a4b5c6d7e8f9g0h1i2j3k4l5m6n7o8p9q0r1s2t3u4v5w6x7y8z9a0b1c2

# --- Environment ---
ENV=production

# --- Database (Railway PostgreSQL) ---
# Deixe vazio - Railway preenche automaticamente ao adicionar PostgreSQL
DATABASE_URL=

# --- ChromaDB (Volume Persistente) ---
# Crie um Volume no Railway em /app/chroma_db
CHROMA_DB_PATH=/app/chroma_db

# --- Rate Limiting (Produção) ---
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_BURST=5

# --- Monitoring (Produção) ---
MONITORING_ENABLED=true
ERROR_REPORTING_ENABLED=true

# ===============================================
# INSTRUÇÕES:
# ===============================================
# 1. Gere novos secrets:
#    python -c "import secrets; print(secrets.token_hex(32))"
#
# 2. No Railway:
#    - Vá em Settings → Variables
#    - Clique em "Raw Editor"
#    - Cole estas variáveis (com novos secrets!)
#
# 3. Adicione PostgreSQL:
#    - Vá em "New" → "Database" → "Add PostgreSQL"
#    - Railway criará DATABASE_URL automaticamente
#
# 4. Crie Volume para ChromaDB:
#    - Vá em Settings → Volumes
#    - Add Volume: Mount Path = /app/chroma_db
# ===============================================
